# Copy to .env (git-ignored) and adjust if needed.

# --- Dev PostgreSQL (docker compose) ---
POSTGRES_USER=mini_erp
POSTGRES_PASSWORD=mini_erp_dev
POSTGRES_DB=mini_erp
POSTGRES_PORT=5434

# Development database (used by the API and by Prisma migrate)
DATABASE_URL=postgresql://mini_erp:mini_erp_dev@127.0.0.1:5434/mini_erp?schema=public

# Separate database for integration tests. Must end with "_test".
# Created automatically by docker compose (prisma/dev/init-test-db.sql).
DATABASE_URL_TEST=postgresql://mini_erp:mini_erp_dev@127.0.0.1:5434/mini_erp_test?schema=public

# --- API ---
# When running inside Electron, PORT/HOST/CORS_ORIGINS are set by the desktop app
# (random free port). These values are only used when running the API on its own.
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173
JWT_SECRET=mini-erp-dev-jwt-secret-change-in-prod

# --- Web (only when running the web app in a normal browser, without Electron) ---
VITE_API_URL=http://127.0.0.1:3000

