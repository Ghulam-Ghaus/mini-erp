// Database schema. Conventions:
// - Tables and columns are snake_case (@@map / @map).
// - Primary keys are gapless integers: NO @default(autoincrement()).
//   Every insert must take its id from `id_counters` inside the same transaction
//   (see apps/api/src/database/gapless-id.ts). A missing id fails the insert.
// - Money: Decimal(14,2). Quantities in base unit (kg): Decimal(12,3). Never Float.

generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Gapless id counters, one row per table. Incremented inside the inserting
/// transaction, so a failed insert rolls the counter back and no number is skipped.
model IdCounter {
  tableName String @id @map("table_name")
  lastValue Int    @map("last_value")

  @@map("id_counters")
}

model Organization {
  id           Int      @id
  name         String
  nameUr       String?  @map("name_ur")
  logoPath     String?  @map("logo_path")
  address      String?
  phone        String?
  email        String?
  taxNo        String?  @map("tax_no")
  currency     String   @default("PKR")
  dateFormat   String   @default("DD/MM/YYYY") @map("date_format")
  settingsJson Json     @default("{}") @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles     Role[]
  users     User[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Role {
  id             Int      @id
  organizationId Int      @map("organization_id")
  code           String
  name           String
  nameUr         String?  @map("name_ur")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  users           User[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id     Int    @id
  module String
  action String

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             Int       @id
  organizationId Int       @map("organization_id")
  roleId         Int       @map("role_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  username       String    @unique
  pinHash        String    @map("pin_hash")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

model AuditLog {
  id             Int      @id
  organizationId Int      @map("organization_id")
  userId         Int?     @map("user_id")
  action         String
  entity         String
  entityId       Int?     @map("entity_id")
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
